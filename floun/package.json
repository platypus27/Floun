{
  "homepage": "https://github.com/platypus27/floun",
  "name": "floun",
  "version": "3.0.0",
  "private": true,
  "description": "On-demand crypto-readiness signal scanner for Chrome.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platypus27/floun.git"
  },
  "bugs": {
    "url": "https://github.com/platypus27/floun/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@kryv/teal": "0.3.0",
    "file-saver": "^2.0.5",
    "lucide-react": "^1.24.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev",
    "check:worker": "node --check build/background.js",
    "release:check": "npm run test && npm run lint && npm run build && npm run audit:prod && npm run typecheck && npm run check:worker",
    "fixture:server": "vite fixtures --host 127.0.0.1 --port 4174",
    "package:extension": "npm run release:check && node ./scripts/package-extension.mjs",
    "release:artifact": "node ./scripts/check-release-artifact.mjs",
    "release:determinism": "node ./scripts/check-package-determinism.mjs",
    "store:check": "node ./scripts/check-store-readiness.mjs",
    "qa:extension:load": "node ./scripts/check-extension-load.mjs",
    "qa:chrome:flows": "node ./scripts/check-chrome-qa-flows.mjs",
    "release:publish:check": "npm run release:ready && node ./scripts/check-publish-readiness.mjs",
    "release:ready": "npm run package:extension && npm run release:artifact && npm run release:determinism && npm run store:check"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.2.0",
    "@types/chrome": "^0.2.2",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
